PORT=3001
DB_HOST=localhost
DB_PORT=3307
DB_USER=runnerexplorer
DB_PASSWORD=runnerexplorer
DB_NAME=runner_explorer
JWT_SECRET=change_this_to_a_long_random_secret
NODE_ENV=development

# URL used to build the link inside verification emails.
# If FRONTEND_URL is set, the link points there as `${FRONTEND_URL}/verify-email?token=...`
# Otherwise the link points directly at this backend's GET endpoint:
#   `${API_BASE_URL}/api/auth/verify-email?token=...`
# If both are empty, defaults to http://localhost:${PORT}
FRONTEND_URL=
API_BASE_URL=http://localhost:3001

# SMTP settings for sending verification emails.
# Leave SMTP_HOST empty to disable real sending; the verification link will
# instead be printed to the server console (safe development fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RunnerQuest <no-reply@csub.local>
